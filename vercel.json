{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/videos/$1"
    },
    {
      "src": "/indexvid2",
      "dest": "/indexvid2.html"
    },
    {
      "src": "/indexvid",
      "dest": "/indexvid2.html"
    },
    {
      "src": "/index1122",
      "dest": "/index1122.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
